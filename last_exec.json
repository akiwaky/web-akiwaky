          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst results = $input.all();\nconst found = results.length > 0 && results[0].json.phone;\nconst row = found ? results[0].json : {};\n\nconst is_new_session = !found;\n\n// Stale check: >3 hours since last_seen_at\nlet is_stale_session = false;\nif (found && row.last_seen_at) {\n  const lastSeen = new Date(row.last_seen_at).getTime();\n  const receivedAt = new Date(input.received_at || Date.now()).getTime();\n  const threeHoursMs = 3 * 60 * 60 * 1000;\n  is_stale_session = (receivedAt - lastSeen) > threeHoursMs;\n}\n\nreturn [{\n  json: {\n    phone: input.phone,\n    display_name: found ? (row.display_name || input.display_name) : (input.display_name || ''),\n    session_status: found ? (row.session_status || 'active') : 'active',\n    short_memory: found ? (row.short_memory || '') : '',\n    last_intent: found ? (row.last_intent || '') : '',\n    last_user_message: found ? (row.last_user_message || '') : '',\n    last_bot_message: found ? (row.last_bot_message || '') : '',\n    last_seen_at: found ? (row.last_seen_at || '') : '',\n    message_count: found ? (parseInt(row.message_count) || 0) : 0,\n    needs_human: found ? (row.needs_human === 'true' || row.needs_human === true) : false,\n    is_new_session: is_new_session,\n    is_stale_session: is_stale_session\n  }\n}];",
          "notice": ""
        },
