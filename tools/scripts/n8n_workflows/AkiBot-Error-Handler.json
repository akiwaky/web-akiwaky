{
    "name": "AkiBot - Error Handler",
    "nodes": [
        {
            "parameters": {},
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ],
            "id": "akibot-error-trigger"
        },
        {
            "parameters": {
                "jsCode": "const error = $input.first().json;\n\n// Extract useful error details\nconst execution = error.execution || {};\nconst workflow = error.workflow || {};\nconst errorData = execution.error || error.error || {};\n\nconst timestamp = new Date().toISOString();\nconst workflowName = workflow.name || 'Unknown workflow';\nconst errorMessage = errorData.message || JSON.stringify(errorData).substring(0, 200);\nconst nodeName = errorData.node || 'Unknown node';\n\n// Try to extract phone/message from execution data if available\nlet phone = '';\nlet incoming_message = '';\ntry {\n  const lastData = execution.lastNodeExecuted || '';\n  // Best effort to get phone from execution context\n  if (execution.data) {\n    const resultData = execution.data.resultData;\n    if (resultData && resultData.runData) {\n      const firstNode = Object.keys(resultData.runData)[0];\n      if (firstNode && resultData.runData[firstNode][0]) {\n        const firstOutput = resultData.runData[firstNode][0].data?.main?.[0]?.[0]?.json;\n        if (firstOutput) {\n          phone = firstOutput.phone || firstOutput.waPhone || '';\n          incoming_message = firstOutput.message_text || firstOutput.messageBody || '';\n        }\n      }\n    }\n  }\n} catch(e) { /* best effort */ }\n\nreturn [{\n  json: {\n    timestamp,\n    phone,\n    display_name: '',\n    incoming_message,\n    intent: '',\n    response_sent: '',\n    kb_hit: false,\n    failed: true,\n    failure_reason: `[${workflowName}] Node: ${nodeName} \u2014 ${errorMessage}`\n  }\n}];"
            },
            "name": "Extract Error Details",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                0
            ],
            "id": "akibot-error-extract",
            "notesInFlow": true,
            "notes": "Extracts workflow name, node, error message, and best-effort phone/message from error execution data"
        },
