{
    "name": "AkiBot - WhatsApp Inbound",
    "nodes": [
        {
            "parameters": {
                "updates": [
                    "messages"
                ],
                "options": {}
            },
            "name": "WhatsApp Trigger",
            "type": "n8n-nodes-base.whatsAppTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ],
            "id": "akibot-wa-trigger",
            "webhookId": "akibot-wa-inbound-native",
            "credentials": {
                "whatsAppTriggerApi": {
                    "id": "nNXwA4H1atnBSTQA",
                    "name": "WhatsApp OAuth account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Normalize Native WhatsApp Trigger payload into internal contract\nconst body = $input.first().json;\n\nlet phone = '';\nlet display_name = '';\nlet message_text = '';\nlet message_type = 'unknown';\n\ntry {\n  const msg = body.messages?.[0];\n  const contact = body.contacts?.[0];\n  \n  if (msg) {\n    phone = msg.from || '';\n    display_name = contact?.profile?.name || phone;\n    \n    // Determine message type\n    if (msg.type === 'text' && msg.text?.body) {\n      message_type = 'text';\n      message_text = msg.text.body.trim();\n    } else {\n      message_type = msg.type || 'unknown'; // image, audio, document, etc.\n      message_text = '';\n    }\n  }\n} catch(e) {\n  console.log('Error parsing WhatsApp payload', e);\n}\n\nconst skip = (!phone || phone === 'unknown') ? 'true' : 'false';\nconst phone_number_id = body.metadata?.phone_number_id || '';\n\nreturn [{\n  json: {\n    phone,\n    display_name,\n    message_text,\n    message_type,\n    received_at: new Date().toISOString(),\n    raw_input: body,\n    skip,\n    phone_number_id\n  }\n}];"
            },
            "name": "Normalize WhatsApp Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                0
            ],
            "id": "akibot-wa-normalize",
            "notesInFlow": true,
            "notes": "Converts native WhatsApp trigger payload into the internal normalized contract"
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": false
                    },
                    "conditions": [
                        {
                            "id": "skip",
                            "leftValue": "={{ $json.skip }}",
                            "rightValue": "false",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "name": "Is Valid?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                440,
                0
            ],
            "id": "akibot-wa-skip"
        },
        {
            "parameters": {
                "workflowId": {
                    "__rl": true,
                    "value": "={{ /*MAIN_CORE_ID*/ }}",
                    "mode": "id"
                },
                "workflowInputs": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "phone": "={{ $('Normalize WhatsApp Payload').first().json.phone }}",
                        "display_name": "={{ $('Normalize WhatsApp Payload').first().json.display_name }}",
                        "message_text": "={{ $('Normalize WhatsApp Payload').first().json.message_text }}",
                        "message_type": "={{ $('Normalize WhatsApp Payload').first().json.message_type }}",
                        "received_at": "={{ $('Normalize WhatsApp Payload').first().json.received_at }}",
                        "raw_input": "={{ JSON.stringify($('Normalize WhatsApp Payload').first().json.raw_input) }}"
                    }
                },
                "options": {
                    "waitForSubWorkflow": true
                }
            },
            "name": "Execute Core",
            "type": "n8n-nodes-base.executeWorkflow",
            "typeVersion": 1.2,
            "position": [
                660,
                100
            ],
            "id": "akibot-wa-core"
        },
        {
            "parameters": {
                "operation": "send",
                "phoneNumberId": "={{ $('Normalize WhatsApp Payload').first().json.phone_number_id }}",
                "recipientPhoneNumber": "={{ '+' + $('Normalize WhatsApp Payload').first().json.phone.replace(/^521/, '52') }}",
                "textBody": "={{ $json.response_text }}",
                "additionalFields": {}
            },
            "name": "Send WhatsApp Reply",
            "type": "n8n-nodes-base.whatsApp",
            "typeVersion": 1.1,
            "position": [
                880,
                100
            ],
            "id": "akibot-wa-send",
            "notesInFlow": true,
            "notes": "Sends reply via native WhatsApp node",
            "credentials": {
                "whatsAppApi": {
                    "id": "qwsx7pWsR8GQmacw",
                    "name": "WhatsApp account"
                }
            }
        }
    ],
    "connections": {
        "WhatsApp Trigger": {
            "main": [
                [
                    {
                        "node": "Normalize WhatsApp Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalize WhatsApp Payload": {
            "main": [
                [
                    {
                        "node": "Is Valid?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Valid?": {
            "main": [
                [
                    {
                        "node": "Execute Core",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Execute Core": {
            "main": [
                [
                    {
                        "node": "Send WhatsApp Reply",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1",
        "callerPolicy": "workflowsFromSameOwner"
    }
}