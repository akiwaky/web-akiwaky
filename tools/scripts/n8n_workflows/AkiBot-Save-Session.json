    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst lookupResults = $input.all();\nconst hasExisting = Boolean(lookupResults.length > 0 && lookupResults[0].json && lookupResults[0].json.phone);\nconst oldCount = hasExisting ? (parseInt(lookupResults[0].json.message_count) || 0) : 0;\nconst rowNumber = hasExisting ? lookupResults[0].json.row_number : undefined;\n\nreturn [{\n  json: {\n    is_existing: hasExisting,\n    row_number: rowNumber,\n    phone: input.phone,\n    display_name: input.display_name || '',\n    session_status: input.session_status || 'active',\n    short_memory: input.short_memory || '',\n    last_intent: input.last_intent || '',\n    last_user_message: input.last_user_message || '',\n    last_bot_message: input.last_bot_message || '',\n    last_seen_at: new Date().toISOString(),\n    message_count: oldCount + 1,\n    needs_human: input.needs_human || false\n  }\n}];"
      },
      "name": "Prepare Upsert Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "akibot-save-prepare"
