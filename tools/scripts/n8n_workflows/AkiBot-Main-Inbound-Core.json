    {
      "parameters": {
        "jsCode": "// Merge session + intent + original input into one object for downstream routing\nconst original = $('When Executed by Another Workflow').first().json;\nconst session = $('Load Session').first().json;\nconst intent = $input.first().json;\n\nreturn [{\n  json: {\n    // Original input\n    phone: original.phone,\n    display_name: original.display_name || session.display_name,\n    message_text: original.message_text,\n    message_type: original.message_type,\n    received_at: original.received_at,\n    // Session data\n    session_status: session.session_status,\n    short_memory: session.short_memory,\n    last_intent: session.last_intent,\n    last_user_message: session.last_user_message,\n    last_bot_message: session.last_bot_message,\n    last_seen_at: session.last_seen_at,\n    message_count: session.message_count,\n    needs_human: session.needs_human,\n    is_new_session: session.is_new_session,\n    is_stale_session: session.is_stale_session,\n    // Intent data\n    intent: intent.intent,\n    confidence: intent.confidence,\n    intent_reason: intent.reason\n  }\n}];"
      },
