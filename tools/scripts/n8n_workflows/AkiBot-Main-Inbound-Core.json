    {
      "parameters": {
        "jsCode": "const original = $('Merge Context').item ? $('Merge Context').first().json : $('When Executed by Another Workflow').first().json;\nconst response = $input.first().json;\n\nconst intent = original.intent || response.intent || 'unknown';\nconst needs_human = intent === 'human_handoff' ? true : (original.needs_human || false);\n\n// Build save session payload\nconst savePayload = {\n  phone: original.phone,\n  display_name: original.display_name,\n  session_status: 'active',\n  short_memory: response.updated_short_memory || '',\n  last_intent: intent,\n  last_user_message: original.message_text,\n  last_bot_message: response.response_text,\n  needs_human: needs_human\n};\n\n// Build log payload\nconst logPayload = {\n  timestamp: new Date().toISOString(),\n  phone: original.phone,\n  display_name: original.display_name,\n  incoming_message: original.message_text,\n  intent: intent,\n  response_sent: response.response_text,\n  kb_hit: response.kb_hit || false,\n  failed: false,\n  failure_reason: ''\n};\n\n// Final output\nreturn [{\n  json: {\n    response_text: response.response_text,\n    intent: intent,\n    kb_hit: response.kb_hit || false,\n    updated_short_memory: response.updated_short_memory || '',\n    needs_human: needs_human,\n    status: 'ok',\n    phone: original.phone,\n    display_name: original.display_name,\n    message_text: original.message_text,\n    message_type: original.message_type || 'text',\n    received_at: original.received_at,\n    _save_payload: savePayload,\n    _log_payload: logPayload\n  }\n}];"
      },
      "name": "Build Final Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -100
      ],
