        ],
        "id": "akibot-classify-trigger"
      },
      {
        "parameters": {
          "resource": "text",
          "operation": "response",
          "modelId": {
            "__rl": true,
            "value": "gpt-4o-mini",
            "mode": "list",
            "cachedResultName": "gpt-4o-mini"
          },
          "responses": {
            "values": [
              {
                "type": "text",
                "role": "system",
                "content": "You are an intent classifier for a WhatsApp bot named AkiBot.\n\nYou must classify the message into exactly one of these categories:\n- greeting\n- kb_question\n- follow_up\n- human_handoff\n- unsupported\n- unknown\n\nMandatory rules:\n1. If the text contains \"#humano\", the final intent must be \"human_handoff\".\n2. If it is a simple greeting or clearly social opener (hola, hey, buenos d\u00edas, qu\u00e9 tal, etc.), return \"greeting\".\n3. If it clearly depends on previous context or references something previously discussed, return \"follow_up\".\n4. If it is a standard question answerable through the knowledge base, return \"kb_question\".\n5. If it is not useful text or does not fit, return \"unknown\".\n6. Do not invent new categories.\n\nReturn only valid JSON in this exact format:\n{\"intent\": \"greeting|kb_question|follow_up|human_handoff|unsupported|unknown\", \"confidence\": 0.0, \"reason\": \"brief explanation\"}"
              },
              {
                "type": "text",
                "role": "user",
                "content": "=Mensaje del usuario: {{ $json.message_text }}\n\nContexto previo (memoria corta): {{ $json.short_memory || 'Sin contexto previo' }}\n\nSesi\u00f3n nueva: {{ $json.is_new_session }}\nSesi\u00f3n inactiva >3h: {{ $json.is_stale_session }}"
              }
            ]
          },
          "simplify": true,
          "builtInTools": {},
          "options": {
            "maxTokens": 200,
            "temperature": 0.1
          }
        },
        "name": "OpenAI Classify",
        "type": "@n8n/n8n-nodes-langchain.openAi",
        "typeVersion": 2.1,
        "position": [
          220,
          0
        ],
        "id": "akibot-classify-openai",
        "credentials": {
          "openAiApi": {
            "id": "EJzHXeV1cCVAx4fw",
            "name": "OpenAi account"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst rawOutput = $input.first().json;\n\n// Try to extract the text from OpenAI response\nlet responseText = '';\nif (rawOutput.message && rawOutput.message.content) {\n  responseText = rawOutput.message.content;\n} else if (rawOutput.choices && rawOutput.choices[0]) {\n  responseText = rawOutput.choices[0].message.content;\n} else if (typeof rawOutput === 'string') {\n  responseText = rawOutput;\n} else {\n  responseText = JSON.stringify(rawOutput);\n}\n\n// Parse JSON from LLM response\nlet intent = 'unknown';\nlet confidence = 0;\nlet reason = 'parse_failed';\n\ntry {\n  // Extract JSON from possible markdown code fences\n  let jsonStr = responseText;\n  const jsonMatch = responseText.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\n  if (jsonMatch) jsonStr = jsonMatch[1].trim();\n  \n  // Also try to find JSON object directly\n  const objMatch = jsonStr.match(/\\{[\\s\\S]*\\}/);\n  if (objMatch) jsonStr = objMatch[0];\n  \n  const parsed = JSON.parse(jsonStr);\n  intent = parsed.intent || 'unknown';\n  confidence = parsed.confidence || 0;\n  reason = parsed.reason || '';\n} catch (e) {\n  intent = 'unknown';\n  confidence = 0;\n  reason = 'LLM response was not valid JSON: ' + responseText.substring(0, 100);\n}\n\n// Hard override: #humano always -> human_handoff\nconst msgText = (input.message_text || '').toLowerCase();\nif (msgText.includes('#humano')) {\n  intent = 'human_handoff';\n  confidence = 1.0;\n  reason = 'Hard rule: message contains #humano';\n}\n\n// Validate intent is in allowed set\nconst allowed = ['greeting', 'kb_question', 'follow_up', 'human_handoff', 'unsupported', 'unknown'];\nif (!allowed.includes(intent)) {\n  intent = 'unknown';\n  reason = 'Invalid intent from LLM: ' + intent;\n}\n\nreturn [{ json: { intent, confidence, reason } }];",
          "notice": ""
        },
        "name": "Parse & Validate Intent",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
